# Live Google keys NEVER belong in this repo. They are read at runtime from
# ~/.google-credentials — nothing here should ever hold them. This rule exists
# so that copying the folder in by accident cannot leak it.
credentials/
*.token.txt
*-oauth.json
*-sa.json

node_modules/

# Phase 6 (finalize-manual-toggles.mjs) screenshot proofs — artifacts, not source.
# The Playwright browser profile lives in ~/.google-credentials/pw-google-profile,
# outside the repo, because it holds a live Google session.
_screenshots/
