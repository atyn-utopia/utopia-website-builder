#!/usr/bin/env bash
#
# Guardrail pre-commit gate.
#
# Blocks a commit if any project you touched has a BLOCKING guardrail failure.
# Source-only (no network / DB needed), so it stays fast and offline-safe.
#
# Install once (from repo root):   git config core.hooksPath .githooks
# Bypass in an emergency:          git commit --no-verify
#
set -euo pipefail

# Which projects have staged changes?
changed=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '^projects/[^/]+/' \
  | sed -E 's#^projects/([^/]+)/.*#\1#' \
  | sort -u || true)

if [ -z "$changed" ]; then
  exit 0   # no project source touched — nothing to gate
fi

# Only gate projects that are real (have inputs.md) — skips admin, empty shells.
slugs=()
for s in $changed; do
  if [ -f "projects/$s/inputs.md" ]; then slugs+=("$s"); fi
done

if [ ${#slugs[@]} -eq 0 ]; then
  exit 0
fi

echo "▶ guardrail gate on: ${slugs[*]}"
cd utopia-wizard
exec npx tsx scripts/gate.ts --source-only "${slugs[@]}"
